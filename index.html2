<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Don't Think - Just Solve (v4.2.6)</title>
<style>
:root {
--bg-color: #0c0a0f;
--panel-bg: #14111a;
--card-inner: #1b1724;
--text-color: #f0f3f8;
--neon-magenta: #e100ff;
--neon-pink: #ff3399;
--neon-cyan: #00f3ff;
--neon-gold: #ffaa00;
--neon-green: #39ff14;
--border-color: #2a2338;
}
body {
background-color: var(--bg-color);
color: var(--text-color);
font-family: system-ui, sans-serif;
margin: 0;
padding: 10px;
display: flex;
flex-direction: column;
align-items: center;
background-size: cover;
background-position: center;
background-repeat: no-repeat;
background-attachment: fixed;
}
.phone-container {
width: 100%;
max-width: 420px;
background: rgba(20, 17, 26, 0.9);
border-radius: 20px;
padding: 15px;
box-shadow: 0 10px 30px rgba(0,0,0,0.7);
border: 1px solid var(--border-color);
box-sizing: border-box;
backdrop-filter: blur(8px);
}
.top-bar {
display: flex;
justify-content: space-between;
align-items: center;
font-size: 11px;
color: #665c78;
margin-bottom: 10px;
}
.mode-badge {
background: transparent;
color: var(--neon-cyan);
border: 1px solid var(--neon-cyan);
padding: 2px 8px;
border-radius: 4px;
font-weight: bold;
cursor: pointer;
}
.mode-cube {
color: var(--neon-pink);
border-color: var(--neon-pink);
}
.tabs {
display: flex;
justify-content: center;
gap: 20px;
margin-bottom: 10px;
font-size: 13px;
font-weight: bold;
color: #554d63;
}
.tab-btn {
cursor: pointer;
padding-bottom: 4px;
white-space: nowrap;
}
.tab-active {
color: var(--text-color);
border-bottom: 2px solid var(--neon-magenta);
}
.scramble-box {
background: rgba(0,0,0,0.3);
border: 1px solid var(--border-color);
border-radius: 8px;
padding: 8px;
font-size: 13px;
color: var(--neon-cyan);
text-shadow: 0 0 5px rgba(0,243,255,0.3);
text-align: center;
font-family: monospace;
margin-bottom: 15px;
word-wrap: break-word;
transition: all 0.2s ease;
}
.scramble-4x4 {
font-size: 11px !important;
line-height: 1.3;
padding: 6px;
}
.vr-display-container {
text-align: center;
margin-bottom: 20px;
padding: 15px;
border-radius: 12px;
background: rgba(0,0,0,0.2);
border: 1px solid var(--border-color);
transition: all 0.5s ease;
}
.new-record-tag {
color: var(--neon-pink);
font-size: 11px;
font-weight: bold;
letter-spacing: 2px;
margin-bottom: 5px;
visibility: hidden;
}
.tier-tag {
font-size: 15px;
font-weight: bold;
letter-spacing: 1px;
transition: color 0.3s;
}
.vr-number {
font-size: 72px;
font-weight: 900;
margin: 5px 0;
font-family: monospace;
transition: all 0.3s ease;
}
.style-unreal-text {
background: linear-gradient(to right, #00f3ff, #ff00ff);
-webkit-background-clip: text;
-webkit-text-fill-color: transparent;
filter: drop-shadow(0 0 15px rgba(0, 243, 255, 0.6)) drop-shadow(0 0 30px rgba(255, 0, 255, 0.4));
}
.style-unreal-border {
border-color: #ff00ff !important;
box-shadow: 0 0 25px rgba(0, 243, 255, 0.4), inset 0 0 15px rgba(255, 0, 255, 0.1);
}
.grid-stats {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 10px;
margin-bottom: 20px;
}
.stat-card {
background: var(--card-inner);
border: 1px solid var(--border-color);
border-radius: 8px;
padding: 10px;
text-align: center;
}
.stat-label {
font-size: 10px;
color: #7d7294;
margin-bottom: 4px;
}
.stat-value {
font-size: 16px;
font-weight: bold;
}
.color-pink { color: var(--neon-pink); }
.color-cyan { color: var(--neon-cyan); }
.ao5-history-bar {
display: flex;
justify-content: space-between;
gap: 5px;
margin-bottom: 25px;
}
.ao5-slot {
flex: 1;
background: var(--card-inner);
border: 1px solid var(--border-color);
border-radius: 4px;
height: 24px;
display: flex;
align-items: center;
justify-content: center;
font-size: 11px;
color: #554d63;
transition: all 0.2s ease;
cursor: pointer;
user-select: none;
}
.ao5-slot-active {
color: var(--neon-cyan);
border-color: rgba(0, 243, 255, 0.3);
background: rgba(0, 243, 255, 0.05);
}
.ao5-slot-plus2 {
color: var(--neon-gold) !important;
border-color: rgba(255, 170, 0, 0.4) !important;
background: rgba(255, 170, 0, 0.08) !important;
}
.ao5-slot-dnf {
color: var(--neon-pink) !important;
border-color: rgba(255, 51, 153, 0.4) !important;
background: rgba(255, 51, 153, 0.08) !important;
}
.input-section {
border-top: 1px solid var(--border-color);
border-bottom: 1px solid var(--border-color);
padding: 15px 0;
text-align: center;
margin-bottom: 15px;
}
.time-enter-hint {
font-size: 22px;
font-weight: bold;
color: #7d7294;
margin-left: 10px;
}
#manual-input {
background: transparent;
border: none;
color: var(--neon-cyan);
font-size: 24px;
font-weight: bold;
text-align: center;
width: 120px;
border-bottom: 2px solid var(--border-color);
outline: none;
}
.fun-input-group {
margin-top: 12px;
display: none;
flex-direction: column;
align-items: center;
gap: 8px;
}
#fun-vr-field {
background: #231c30;
border: 1px solid var(--border-color);
color: var(--neon-green);
padding: 6px;
border-radius: 4px;
text-align: center;
font-weight: bold;
outline: none;
width: 140px;
}
.fun-btn {
background: var(--card-inner);
color: var(--neon-cyan);
border: 1px solid var(--border-color);
padding: 6px 12px;
border-radius: 4px;
font-size: 12px;
cursor: pointer;
font-weight: bold;
}
.battle-report-bar {
display: flex;
justify-content: space-between;
align-items: center;
margin-bottom: 15px;
}
.rank-badge {
font-size: 24px;
font-weight: 900;
color: var(--neon-cyan);
text-shadow: 0 0 10px rgba(0,243,255,0.4);
}
.vr-change-badge {
font-size: 18px;
font-weight: 900;
opacity: 0;
transform: translateY(10px);
transition: all 0.4s ease;
}
.vr-change-show {
opacity: 1;
transform: translateY(0);
}
.vr-plus { color: var(--neon-green); text-shadow: 0 0 8px var(--neon-green); }
.vr-minus { color: var(--neon-pink); text-shadow: 0 0 8px var(--neon-pink); }
.lobby-summary {
font-size: 11px;
color: #6d6480;
margin-bottom: 15px;
}
.lobby-summary span { color: #a197ba; }
.leaderboard-title {
font-size: 12px;
font-weight: bold;
color: #7d7294;
margin-bottom: 10px;
}
.leaderboard-list {
display: flex;
flex-direction: column;
gap: 6px;
max-height: 180px;
overflow-y: auto;
}
.leaderboard-row {
display: flex;
justify-content: space-between;
font-size: 12px;
padding: 6px 8px;
border-radius: 4px;
background: #191522;
opacity: 0;
transform: translateX(30px);
}
@keyframes slideInRow {
to { opacity: 1; transform: translateX(0); }
}
.row-player {
background: rgba(255, 38, 225, 0.15) !important;
border: 1px solid var(--neon-magenta) !important;
font-weight: bold;
}
.col-left { display: flex; gap: 12px; align-items: center; }
.col-right { display: flex; gap: 15px; font-family: monospace; align-items: center; }
.bot-rank { color: var(--neon-gold); font-weight: 900; }
.bot-name { color: #c3bcda; }
.bot-vr { color: #5c546d; }
.bot-time { font-weight: bold; color: var(--neon-gold); }
.player-time { color: var(--neon-cyan) !important; text-shadow: 0 0 5px var(--neon-cyan); }
.upload-btn-container {
margin-top: 15px;
text-align: center;
}
#bg-upload { display: none; }
.upload-label {
background: #231c30;
color: #a197ba;
border: 1px solid var(--border-color);
padding: 8px 16px;
border-radius: 6px;
font-size: 12px;
cursor: pointer;
display: inline-block;
}
</style>
</head>
<body>
<div class="phone-container">
<div class="top-bar">
<span>Life = Cube = Life</span>
<button class="mode-badge mode-cube" id="ui-mode-toggle" onclick="toggleMode()">MODE: CUBE</button>
</div>
<div class="tabs" id="ui-tabs-container">
<span class="tab-btn tab-active" onclick="switchUniverse('3x3')">3x3</span>
<span class="tab-btn" onclick="switchUniverse('2x2')">2x2</span>
<span class="tab-btn" onclick="switchUniverse('4x4')">4x4</span>
<span class="tab-btn" onclick="switchUniverse('OH')">ONE-HANDED</span>
</div>
<div id="ui-scramble-display" class="scramble-box">GENERATING SCRAMBLE...</div>
<div class="vr-display-container" id="ui-glow-box">
<div class="new-record-tag" id="ui-new-record">[NEW RECORD!]</div>
<div class="tier-tag" id="ui-tier-name">[NEWBIE I]</div>
<div class="vr-number" id="ui-player-vr">1</div>
</div>
<div class="grid-stats">
<div class="stat-card">
<div class="stat-label">Peak VR</div>
<div class="stat-value color-pink" id="ui-peak-vr">1</div>
</div>
<div class="stat-card">
<div class="stat-label">Baseline</div>
<div class="stat-value color-cyan" id="ui-baseline-val">54.99s</div>
</div>
<div class="stat-card">
<div class="stat-label">Total Races</div>
<div class="stat-value" id="ui-total-matches">0</div>
</div>
<div class="stat-card">
<div class="stat-label">Win % / Podiums</div>
<div class="stat-value color-cyan" id="ui-podium-rate">0% / 0</div>
</div>
</div>
<div class="ao5-history-bar" id="ui-ao5-slots">
<div class="ao5-slot">-</div>
<div class="ao5-slot">-</div>
<div class="ao5-slot">-</div>
<div class="ao5-slot">-</div>
<div class="ao5-slot">-</div>
</div>
<div class="input-section">
<input type="number" step="0.01" id="manual-input" placeholder="0.00" onkeydown="handleEnter(event)">
<span class="time-enter-hint" id="ui-input-hint">TIME + ENTER</span>
<div class="fun-input-group" id="ui-fun-inputs">
<input type="number" id="fun-vr-field" placeholder="Enter VR (1-9999)">
<button class="fun-btn" onclick="triggerFunSetVR()">SET CUSTOM VR</button>
</div>
</div>
<div class="battle-report-bar">
<div class="rank-badge" id="ui-match-rank">0th / 24</div>
<div class="vr-change-badge" id="ui-vr-change">+0 VR</div>
</div>
<div class="lobby-summary">
Room Average VR: <span id="ui-room-avg">-</span> | 
Multiplier: <span id="ui-multiplier">-</span> | 
ao5: <span id="ui-current-ao5">-</span>
</div>
<div class="leaderboard-title">🏁 Race Results: </div>
<div class="leaderboard-list" id="ui-leaderboard-list"></div>
<div class="upload-btn-container">
<label for="bg-upload" class="upload-label">📸 Select Photos from Gallery </label>
<input type="file" id="bg-upload" accept="image/*" onchange="handleBackgroundUpload(event)">
</div>
</div>
<script>
    let playerVR = { "3x3": 1, "2x2": 1, "4x4": 1, "OH": 1 };
let peakVR = { "3x3": 1, "2x2": 1, "4x4": 1, "OH": 1 };
let totalMatches = { "3x3": 0, "2x2": 0, "4x4": 0, "OH": 0 };
let podiumCount = { "3x3": 0, "2x2": 0, "4x4": 0, "OH": 0 };
let recentScores = { "3x3": [], "2x2": [], "4x4": [], "OH": [] };
let currentSolvePool = [];
let currentPoolStates = []; // ⚡ 完美補齊空括號！追蹤點擊狀態：0=正常, 1=+2s, 2=DNF
let currentUniverse = "3x3";
let currentMode = "CUBE";
let persistentLobby = [];

// 精準對齊你的 4x4 與 OH 核心物理公式
const UNIVERSE_CONFIG = {
"3x3": { base: 5, div: 200, minB: 5.0 },
"2x2": { base: 1.5, div: 800, minB: 1.0 },
"4x4": { base: 20, div: 80, minB: 16.0 }, // 20 + (10000 - VR) / 80
"OH": { base: 12, div: 125, minB: 8.5 }
};

const TIER_MATRIX = [
{ min: 9999, name: "[UNREAL]", color: "linear-gradient" },
{ min: 9800, name: "[LEGENDARY V]", color: "#ff007f" },
{ min: 9600, name: "[LEGENDARY IV]", color: "#ff00bb" },
{ min: 9400, name: "[LEGENDARY III]", color: "#ff00ff" },
{ min: 9200, name: "[LEGENDARY II]", color: "#cc00ff" },
{ min: 9000, name: "[LEGENDARY I]", color: "#9900ff" },
{ min: 8800, name: "[MASTER V]", color: "#ffaa00" },
{ min: 8600, name: "[MASTER IV]", color: "#ffbb00" },
{ min: 8400, name: "[MASTER III]", color: "#ffcc00" },
{ min: 8200, name: "[MASTER II]", color: "#ffdd00" },
{ min: 8000, name: "[MASTER I]", color: "#ffee00" },
{ min: 7500, name: "[PRO V]", color: "#00ff66" },
{ min: 6800, name: "[PRO IV]", color: "#00ff99" },
{ min: 6100, name: "[PRO III]", color: "#00ffcc" },
{ min: 5400, name: "[PRO II]", color: "#00ffff" },
{ min: 4700, name: "[PRO I]", color: "#00ccff" },
{ min: 4000, name: "[ELITE IV]", color: "#3399ff" },
{ min: 3300, name: "[ELITE III]", color: "#5588ff" },
{ min: 2500, name: "[ELITE II]", color: "#7777ff" },
{ min: 1500, name: "[ELITE I]", color: "#9966ff" },
{ min: 1200, name: "[NEWBIE V]", color: "#a197ba" },
{ min: 900, name: "[NEWBIE IV]", color: "#8d83a8" },
{ min: 600, name: "[NEWBIE III]", color: "#796f96" },
{ min: 400, name: "[NEWBIE II]", color: "#655c84" },
{ min: 1, name: "[NEWBIE I]", color: "#514a72" }
];

function updateTierGraphics(targetVR) {
let activeTier = TIER_MATRIX[TIER_MATRIX.length - 1];
for (let i = 0; i < TIER_MATRIX.length; i++) {
if (targetVR >= TIER_MATRIX[i].min) {
activeTier = TIER_MATRIX[i];
break;
}
}
const tierTag = document.getElementById("ui-tier-name");
const vrNum = document.getElementById("ui-player-vr");
const glowBox = document.getElementById("ui-glow-box");
tierTag.innerText = activeTier.name;
if (activeTier.min === 9999) {
tierTag.className = "tier-tag style-unreal-text";
vrNum.className = "vr-number style-unreal-text";
glowBox.classList.add("style-unreal-border");
} else {
tierTag.className = "tier-tag";
vrNum.className = "vr-number";
glowBox.classList.remove("style-unreal-border");
tierTag.style.color = activeTier.color;
vrNum.style.color = activeTier.color;
vrNum.style.textShadow = `0 0 20px ${activeTier.color}`;
glowBox.style.borderColor = activeTier.color;
glowBox.style.boxShadow = `0 0 15px ${activeTier.color}44`;
}
}
function toggleMode() {
const btn = document.getElementById("ui-mode-toggle");
const funArea = document.getElementById("ui-fun-inputs");
if (currentMode === "CUBE") {
currentMode = "FUN";
btn.innerText = "MODE: FUN";
btn.classList.remove("mode-cube");
funArea.style.display = "flex";
} else {
currentMode = "CUBE";
btn.innerText = "MODE: CUBE";
btn.classList.add("mode-cube");
funArea.style.display = "none";
}
}

function triggerFunSetVR() {
if (currentMode !== "FUN") return;
const val = parseInt(document.getElementById("fun-vr-field").value);
if (isNaN(val) || val < 1 || val > 9999) {
alert("PLZ ENTER A NUMBER BETWEEN 1 AND 9999");
return;
}
playerVR[currentUniverse] = val;
if (playerVR[currentUniverse] > peakVR[currentUniverse]) peakVR[currentUniverse] = playerVR[currentUniverse];
document.getElementById("ui-player-vr").innerText = playerVR[currentUniverse];
document.getElementById("ui-peak-vr").innerText = peakVR[currentUniverse];
const config = UNIVERSE_CONFIG[currentUniverse];
const currentBaseline = config.base + (10000 - playerVR[currentUniverse]) / config.div;
document.getElementById("ui-baseline-val").innerText = `${Math.max(config.minB, currentBaseline).toFixed(2)}s`;
updateTierGraphics(playerVR[currentUniverse]);
initLobby();
}

function handleBackgroundUpload(event) {
// ⚡ 核心修復：精準抓取索引 0 解決原本 undefined 的問題
const file = event.target.files[0]; 
if (file) {
const reader = new FileReader();
reader.onload = function(e) {
document.body.style.backgroundImage = "url('" + e.target.result + "')";
};
reader.readAsDataURL(file);
}
}

function generate3x3Scramble() {
const faces = ["R", "L", "U", "D", "F", "B"];
// 換成這一行（用字串拆解成陣列，完全避開代碼編輯器吞括號的 Bug）
const axes = "001122".split("").map(Number); // 對應 0:R/L, 1:U/D, 2:F/B
const modifiers = ["", "'", "2"];
let scramble = [];
let lastFace = -1;
let secondLastFace = -1;
for (let i = 0; i < 20; i++) {
let chosenFaceIdx, chosenAxis;
while (true) {
chosenFaceIdx = Math.floor(Math.random() * faces.length);
chosenAxis = axes[chosenFaceIdx];
if (chosenFaceIdx === lastFace) continue;
if (lastFace !== -1 && axes[lastFace] === chosenAxis) {
if (chosenFaceIdx === secondLastFace) continue;
}
break;
}
let modifier = modifiers[Math.floor(Math.random() * modifiers.length)];
scramble.push(faces[chosenFaceIdx] + modifier);
secondLastFace = lastFace;
lastFace = chosenFaceIdx;
}
return scramble.join(" ");
}

function generate4x4Scramble() {
const movesConfig = [
{ face: "R", axis: 0 }, { face: "L", axis: 0 }, { face: "Rw", axis: 0 },
{ face: "U", axis: 1 }, { face: "D", axis: 1 }, { face: "Uw", axis: 1 },
{ face: "F", axis: 2 }, { face: "B", axis: 2 }, { face: "Fw", axis: 2 }
];
const modifiers = ["", "'", "2"];
let scramble = [];
let lastMoveIdx = -1;
let secondLastMoveIdx = -1;
for (let i = 0; i < 40; i++) {
let chosenIdx, currentMove, currentAxis;
while (true) {
chosenIdx = Math.floor(Math.random() * movesConfig.length);
currentMove = movesConfig[chosenIdx];
currentAxis = currentMove.axis;
if (lastMoveIdx !== -1 && movesConfig[lastMoveIdx].face === currentMove.face) continue;
if (lastMoveIdx !== -1 && movesConfig[lastMoveIdx].axis === currentAxis) {
if (secondLastMoveIdx !== -1 && movesConfig[secondLastMoveIdx].face === currentMove.face) continue;
}
break;
}
let modifier = modifiers[Math.floor(Math.random() * modifiers.length)];
scramble.push(currentMove.face + modifier);
secondLastMoveIdx = lastMoveIdx;
lastMoveIdx = chosenIdx;
}
return scramble.join(" ");
}

function generateAndDisplayScramble() {
const display = document.getElementById("ui-scramble-display");
if (currentUniverse === "2x2") {
display.classList.remove("scramble-4x4");
const moves = ["R", "U", "F"];
const modifiers = ["", "'", "2"];
let scramble = [];
let lastFace = "";
for (let i = 0; i < 7; i++) {
let face;
do {
face = moves[Math.floor(Math.random() * moves.length)];
} while (face === lastFace);
scramble.push(face + modifiers[Math.floor(Math.random() * modifiers.length)]);
lastFace = face;
}
display.innerText = scramble.join(" ");
} else if (currentUniverse === "4x4") {
display.classList.add("scramble-4x4"); // 動態將 4x4 字型縮小到 11px
display.innerText = generate4x4Scramble();
} else {
display.classList.remove("scramble-4x4");
display.innerText = generate3x3Scramble();
}
}

function initLobby() {
persistentLobby = [];
for (let i = 1; i <= 23; i++) {
let rolledVR = Math.round(playerVR[currentUniverse] + (Math.random() * 500 - 250));
persistentLobby.push({
id: i,
name: `Cuber_Bot_${Math.floor(Math.random() * 90 + 10)}`,
vr: Math.max(1, Math.min(10000, rolledVR)) // 邊界鉗制防禦
});
}
}

function cycleLobby() {
let quitCount = Math.floor(Math.random() * 3) + 2;
persistentLobby.sort(() => Math.random() - 0.5);
persistentLobby.splice(0, quitCount);
for (let i = 0; i < quitCount; i++) {
let rolledVR = Math.round(playerVR[currentUniverse] + (Math.random() * 700 - 350));
persistentLobby.push({
id: Math.floor(Math.random() * 1000),
name: `Cuber_Bot_${Math.floor(Math.random() * 90 + 10)}`,
vr: Math.max(1, Math.min(10000, rolledVR))
});
}
}

function gaussianRandom(mean, stdDev) {
let u = 0, v = 0;
while(u === 0) u = Math.random(); 
while(v === 0) v = Math.random();
return (Math.sqrt(-2.0 * Math.log(u)) * Math.cos(2.0 * Math.PI * v)) * stdDev + mean;
}
function handleEnter(e) {
    // 🛡️ 1. 全平台手機/電腦相容性鍵盤判斷
    if (e.key !== 'Enter' && e.code !== 'Enter' && e.keyCode !== 13) {
        return;
    }
    
    // 🛡️ 2. 防溢出保護盾：如果已經錄入了 5 次成績正在等結算，直接攔截不重複塞入
    if (currentSolvePool.length >= 5) {
        e.target.value = "";
        return;
    }

    const val = parseFloat(e.target.value);
    if (isNaN(val) || val <= 0) return;
    e.target.value = "";

    currentSolvePool.push(val);
    const activeIndex = currentSolvePool.length - 1;
    currentPoolStates[activeIndex] = 0;

    const slots = document.getElementById("ui-ao5-slots").children;
    const currentSlot = slots[activeIndex];

    // 🛡️ 3. 雙重保險：確認節點存在才進行渲染，徹底消滅 660 行的 undefined 錯誤！
    if (currentSlot) {
        currentSlot.innerText = val.toFixed(2) + "s";
        currentSlot.classList.add("ao5-slot-active");
        
        currentSlot.onclick = function() {
            toggleSlotPenalty(activeIndex);
        };
    }
// 當滿 5 次時，順暢啟動 WCA 去頭去尾賽事配對引擎
    if (currentSolvePool.length === 5) {
        processAo5Calculation();
    }
}

function toggleSlotPenalty(index) {
currentPoolStates[index] = (currentPoolStates[index] + 1) % 3;

const slots = document.getElementById("ui-ao5-slots").children;
const currentSlot = slots[index];
const baseTime = currentSolvePool[index];

currentSlot.className = "ao5-slot ao5-slot-active";

if (currentPoolStates[index] === 0) {
currentSlot.innerText = baseTime.toFixed(2) + "s";
} 
else if (currentPoolStates[index] === 1) {
currentSlot.classList.add("ao5-slot-plus2");
currentSlot.innerText = (baseTime + 2.0).toFixed(2) + "s+";
} 
else if (currentPoolStates[index] === 2) {
currentSlot.classList.add("ao5-slot-dnf");
currentSlot.innerText = "DNF";
}
}

function processAo5Calculation() {
    document.getElementById("ui-input-hint").innerText = "CALCULATING Ao5...";
    const slots = document.getElementById("ui-ao5-slots").children;
    
    setTimeout(() => {
        let processedPool = [];
        let dnfCount = 0;
        
        // 統計 DNF 與計算罰秒
        for (let i = 0; i < 5; i++) {
            if (currentPoolStates[i] === 2) {
                dnfCount++;
                processedPool.push(Infinity); // 用數學上的無限大代表 DNF，方便後續排序剔除
            } else if (currentPoolStates[i] === 1) {
                processedPool.push(currentSolvePool[i] + 2.0);
            } else {
                processedPool.push(currentSolvePool[i]);
            }
        }
        
        // 重置所有計分格的點擊監聽與外觀類別
        for (let i = 0; i < 5; i++) {
            slots[i].onclick = null;
            slots[i].innerText = "-";
            slots[i].className = "ao5-slot";
        }
        
        currentSolvePool = [];
        currentPoolStates = new Array();
        document.getElementById("ui-input-hint").innerText = "TIME + ENTER";
        generateAndDisplayScramble();
        
        // ⚡ 正規 WCA 規則判定：只有當出現 2 個或更多 DNF 時，Ao5 才會死當，執行扣 200 VR 懲罰
        if (dnfCount >= 2) {
            handleDnfMatchFailure();
            return;
        }
        
        // ⚡ 如果只有 1 個 DNF (或 0 個 DNF)，進行標準排序
        processedPool.sort((a, b) => a - b);
        
        // 此時如果含有 1 個 DNF，它已經身為 Infinity 被排到了最右邊（最大值被剔除）
        // 排序後的索引 1、2、3 保證絕對是排除掉最快、以及排除掉 DNF 之後的「中間三盤正常成績」！
        let finalAo5 = (Number(processedPool[1]) + Number(processedPool[2]) + Number(processedPool[3])) / 3;
        
        recentScores[currentUniverse].unshift(finalAo5);
        if (recentScores[currentUniverse].length > 5) recentScores[currentUniverse].pop();
        
        runMatchEngine(finalAo5);
    }, 600);
}


function handleDnfMatchFailure() {
    totalMatches[currentUniverse]++;
    
    const rankBadge = document.getElementById("ui-match-rank");
    if (rankBadge) rankBadge.innerText = "DNF / 24";
    
    const changeBadge = document.getElementById("ui-vr-change");
    if (changeBadge) {
        changeBadge.innerText = "-200 VR";
        changeBadge.className = "vr-change-badge vr-minus vr-change-show";
    }
    
    const oldVR = playerVR[currentUniverse];
    playerVR[currentUniverse] = Math.max(1, playerVR[currentUniverse] - 200);
    
    // ⚡ 視覺修正：扣分降級時，強制將新紀錄標籤隱藏
    const recordTag = document.getElementById("ui-new-record");
    if (recordTag) recordTag.style.visibility = "hidden";
    
    const listContainer = document.getElementById("ui-leaderboard-list");
    if (listContainer) listContainer.innerHTML = "";
    
    const ao5Element = document.getElementById("ui-current-ao5");
    if (ao5Element) ao5Element.innerText = "DNF";
    
    let currentTick = oldVR;
    clearInterval(window.tickInterval);
    window.tickInterval = setInterval(() => {
        if (currentTick <= playerVR[currentUniverse]) {
            clearInterval(window.tickInterval);
            updateTierGraphics(playerVR[currentUniverse]);
            
            const config = UNIVERSE_CONFIG[currentUniverse];
            const updatedBaseline = config.base + (10000 - playerVR[currentUniverse]) / config.div;
            const baseValElement = document.getElementById("ui-baseline-val");
            if (baseValElement) baseValElement.innerText = Math.max(config.minB, updatedBaseline).toFixed(2) + "s";
        } else {
            currentTick -= 1;
            const vrDisplay = document.getElementById("ui-player-vr");
            if (vrDisplay) vrDisplay.innerText = currentTick;
            updateTierGraphics(currentTick);
        }
    }, 2);
    
    cycleLobby();
}

function runMatchEngine(calculatedAo5) {
if (!persistentLobby || persistentLobby.length === 0) initLobby();
totalMatches[currentUniverse]++;
const config = UNIVERSE_CONFIG[currentUniverse];
const baseline = config.base + (10000 - playerVR[currentUniverse]) / config.div;
let matchResults = [];

persistentLobby.forEach(bot => {
const vrDiff = bot.vr - playerVR[currentUniverse];
const botBaseline = baseline * (1 - (vrDiff / 25000));
const botSkillFactor = Math.max(100, bot.vr);
const humanConsistency = 0.03 + (10000 - botSkillFactor) / 100000;

let mult = gaussianRandom(1.0, humanConsistency);
mult = Math.max(0.75, Math.min(1.35, mult));

if (Math.random() < 0.01) {
mult *= 0.85;
}

matchResults.push({
name: bot.name,
vr: Math.max(1, bot.vr),
time: parseFloat((Math.max(config.minB, botBaseline * mult)).toFixed(2)),
isPlayer: false
});
});

matchResults.push({ name: "YOU", vr: playerVR[currentUniverse], time: calculatedAo5, isPlayer: true });
matchResults.sort((a, b) => a.time - b.time);
const playerRank = matchResults.findIndex(x => x.isPlayer) + 1;
if (playerRank <= 3) podiumCount[currentUniverse]++;

const totalBotVR = persistentLobby.reduce((sum, b) => sum + b.vr, 0);
const avgBotVR = Math.max(1, Math.round(totalBotVR / 23));

// ⚡ 核心數值平衡修正：計算線性等比，並用 Math.min 將倍率鎖定在 0.4x 到 2.5x 之間，粉碎低分溢出 Bug
let bMultiplier = avgBotVR / Math.max(1, playerVR[currentUniverse]);
bMultiplier = Math.min(1.2, Math.max(0.8, bMultiplier));

const rankBonus = 1 + (12 - playerRank) * 0.02;
const timeDiff = baseline - calculatedAo5;

let vrChange = (timeDiff / 0.03) * bMultiplier;

if (vrChange >= 0) {
vrChange = vrChange * rankBonus;
} else {
vrChange = vrChange * (2 - rankBonus);
}

if (playerRank === 1) vrChange = Math.max(200, vrChange);
if (playerRank === 2) vrChange = Math.max(150, vrChange);
if (playerRank === 3) vrChange = Math.max(100, vrChange);
vrChange = Math.round(vrChange);

if (playerRank === 1) vrChange = Math.max(10, vrChange);
if (playerRank === 24) vrChange = Math.min(-10, vrChange);

const oldVR = playerVR[currentUniverse];
playerVR[currentUniverse] = Math.max(1, Math.min(10000, playerVR[currentUniverse] + vrChange));

let isNewRecord = false;
if (playerVR[currentUniverse] > peakVR[currentUniverse]) {
peakVR[currentUniverse] = playerVR[currentUniverse];
isNewRecord = true;
}

// ⚡ 防戰報爆分盾：計算真正注入天梯的實際分數變動，不讓 UI 虛報好幾萬的爆分
const realNextVR = Math.max(1, Math.min(10000, oldVR + vrChange));
const realChange = realNextVR - oldVR;

const nextBaseline = config.base + (10000 - playerVR[currentUniverse]) / config.div;

// 傳遞經由保護盾修正後的 realChange
animateMarioKartMetrics(playerRank, realChange, oldVR, playerVR[currentUniverse], avgBotVR, bMultiplier, calculatedAo5, nextBaseline, matchResults, isNewRecord);
cycleLobby();
}

function animateMarioKartMetrics(rank, change, startVR, targetVR, avgVR, mult, ao5, nextRoundBaseline, list, isNewRecord) {
    const rankBadge = document.getElementById("ui-match-rank");
    if (rankBadge) rankBadge.innerText = rank + getRankSuffix(rank) + " / 24";
    
    const changeBadge = document.getElementById("ui-vr-change");
    if (changeBadge) {
        changeBadge.className = "vr-change-badge";
        setTimeout(() => {
            if (change >= 0) {
                changeBadge.innerText = "+" + change + " VR";
                changeBadge.className = "vr-change-badge vr-plus vr-change-show";
            } else {
                changeBadge.innerText = change + " VR";
                changeBadge.className = "vr-change-badge vr-minus vr-change-show";
            }
        }, 10);
    }
    
    const vrDisplay = document.getElementById("ui-player-vr");
    let currentTick = startVR;
    clearInterval(window.tickInterval);
    
    window.tickInterval = setInterval(() => {
        if (currentTick === targetVR) {
            clearInterval(window.tickInterval);
            const peakElement = document.getElementById("ui-peak-vr");
            if (peakElement) peakElement.innerText = peakVR[currentUniverse];
            
            // ⚡ 破紀錄標籤精準控制：只有當最終 targetVR 真的大於原本的 oldPeak 且有正向增加時才顯示
            const recordTag = document.getElementById("ui-new-record");
            if (recordTag) {
                recordTag.style.visibility = (isNewRecord && targetVR >= peakVR[currentUniverse]) ? "visible" : "hidden";
            }
            updateTierGraphics(playerVR[currentUniverse]);
            
            const baseValElement = document.getElementById("ui-baseline-val");
            if (baseValElement) {
                const config = UNIVERSE_CONFIG[currentUniverse];
                baseValElement.innerText = Math.max(config.minB, nextRoundBaseline).toFixed(2) + "s";
            }
        } else {
            if (startVR !== targetVR) {
                currentTick += change > 0 ? 1 : -1;
            }
            if (vrDisplay) vrDisplay.innerText = currentTick;
            updateTierGraphics(currentTick);
        }
    }, Math.max(5, Math.min(25, 400 / (Math.abs(change) || 1))));
    
    const totalMElement = document.getElementById("ui-total-matches");
    if (totalMElement) totalMElement.innerText = totalMatches[currentUniverse];
    
    const podiumRateElement = document.getElementById("ui-podium-rate");
    if (podiumRateElement) {
        const totalM = totalMatches[currentUniverse] || 1;
        podiumRateElement.innerText = ((podiumCount[currentUniverse] / totalM) * 100).toFixed(0) + "% / " + podiumCount[currentUniverse];
    }
    
    const roomAvgElement = document.getElementById("ui-room-avg");
    if (roomAvgElement) roomAvgElement.innerText = avgVR;
    
    const multElement = document.getElementById("ui-multiplier");
    if (multElement) multElement.innerText = mult.toFixed(2) + "x";
    
    const ao5Element = document.getElementById("ui-current-ao5");
    if (ao5Element) ao5Element.innerText = ao5.toFixed(2) + "s";
    
    const listContainer = document.getElementById("ui-leaderboard-list");
    if (listContainer) {
        listContainer.innerHTML = "";
        list.forEach((p, idx) => {
            const row = document.createElement("div");
            row.className = p.isPlayer ? "leaderboard-row row-player" : "leaderboard-row";
            row.innerHTML = `<div class='col-left'><span class='bot-rank'>${idx + 1}</span><span class='bot-name'>${p.name}</span></div><div class='col-right'><span class='bot-vr'>[${p.vr}]</span><span class='bot-time ${p.isPlayer ? "player-time" : ""}'>${p.time.toFixed(2)}s</span></div>`;
            row.style.animation = "slideInRow 0.2s ease forwards";
            row.style.animationDelay = (idx * 0.012) + "s";
            listContainer.appendChild(row);
        });
    }
}


function getRankSuffix(r) {
if (r === 1) return "st";
if (r === 2) return "nd";
if (r === 3) return "rd";
return "th";
}

function switchUniverse(targetUniverse) {
    currentUniverse = targetUniverse;
    
    // 🛡️ 智能動態切換高亮：自動比對點擊的名字，100% 避免索引超出 undefined 的錯誤
    const tabs = document.getElementById("ui-tabs-container").children;
    for (let i = 0; i < tabs.length; i++) {
        const tab = tabs[i];
        // 取得按鈕上的字串（並去除前後空格與大小寫干擾）
        const tabText = tab.innerText.trim().toUpperCase();
        
        // 根據按鈕文字動態激活對應的樣式
        if (
            (targetUniverse === "3x3" && tabText === "3X3") ||
            (targetUniverse === "2x2" && tabText === "2X2") ||
            (targetUniverse === "4x4" && tabText === "4X4") ||
            (targetUniverse === "OH" && (tabText === "ONE-HANDED" || tabText === "OH"))
        ) {
            tab.classList.add("tab-active");
        } else {
            tab.classList.remove("tab-active");
        }
    }

    // 重置目前計分池
    currentSolvePool = [];
    const slots = document.getElementById("ui-ao5-slots").children;
    for (let i = 0; i < 5; i++) {
        slots[i].onclick = null;
        slots[i].innerText = "-";
        slots[i].className = "ao5-slot";
    }

    // 更新目前項目的數據面板
    document.getElementById("ui-player-vr").innerText = playerVR[currentUniverse];
    document.getElementById("ui-peak-vr").innerText = peakVR[currentUniverse];
    document.getElementById("ui-total-matches").innerText = totalMatches[currentUniverse];
    
    const totalM = totalMatches[currentUniverse] || 1;
    document.getElementById("ui-podium-rate").innerText = ((podiumCount[currentUniverse] / totalM) * 100).toFixed(0) + "% / " + podiumCount[currentUniverse];

    // 即時渲染當前項目的 Baseline（完美契合你的 4x4 與 OH 各自公式）
    const config = UNIVERSE_CONFIG[currentUniverse];
    const currentBaseline = config.base + (10000 - playerVR[currentUniverse]) / config.div;
    document.getElementById("ui-baseline-val").innerText = Math.max(config.minB, currentBaseline).toFixed(2) + "s";

    updateTierGraphics(playerVR[currentUniverse]);
    generateAndDisplayScramble();
    initLobby();

    // 清空前一場比賽殘留的即時面板戰報
    document.getElementById("ui-match-rank").innerText = "0th / 24";
    document.getElementById("ui-vr-change").className = "vr-change-badge";
    document.getElementById("ui-vr-change").innerText = "+0 VR";
    document.getElementById("ui-room-avg").innerText = "-";
    document.getElementById("ui-multiplier").innerText = "-";
    document.getElementById("ui-current-ao5").innerText = "-";
    document.getElementById("ui-leaderboard-list").innerHTML = "";
}

// 系統初始啟動疊棧
updateTierGraphics(playerVR[currentUniverse]);
generateAndDisplayScramble();
initLobby();
</script>
</body>
</html>
